          "min": 0,
          "max": 65535,
          "order": 40,
          "xmlPath": "@address",
          "default": 0,
          "nameKey": "DrvModbusCategoriesReadCommandsFieldsAddressName"
        },
        {
          "id": "registers",
          "name": "Registers",

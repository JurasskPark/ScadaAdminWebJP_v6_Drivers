              "type": "select",
              "required": true,
              "order": 30,
              "xmlPath": "@type",
              "default": "ushort",
              "options": [
                {
                  "value": "bool",
                  "label": "Bool",
                  "labelKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeOptionsBoolLabel"
                },
                {
                  "value": "short",
                  "label": "Int16",
                  "labelKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeOptionsShortLabel"
                },
                {
                  "value": "ushort",
                  "label": "UInt16",
                  "labelKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeOptionsUshortLabel"
                },
                {
                  "value": "int",
                  "label": "Int32",
                  "labelKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeOptionsIntLabel"
                },
                {
                  "value": "uint",
                  "label": "UInt32",
                  "labelKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeOptionsUintLabel"
                },
                {
                  "value": "float",
                  "label": "Float",
                  "labelKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeOptionsFloatLabel"
                },
                {
                  "value": "double",
                  "label": "Double",
                  "labelKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeOptionsDoubleLabel"
                }
              ],
              "nameKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsElementTypeName"
            },
            {
              "id": "byteOrder",
              "name": "Byte order",
              "type": "string",
              "order": 40,
              "xmlPath": "@byteOrder",
              "default": "",
              "omitIfEmpty": true,
              "nameKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsByteOrderName"
            },
            {
              "id": "readOnly",
              "name": "Read-only",
              "type": "boolean",
              "order": 50,
              "xmlPath": "@readOnly",
              "default": false,
              "nameKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsReadOnlyName"
            },
            {
              "id": "isBitMask",
              "name": "Bit mask",
              "type": "boolean",
              "order": 60,
              "xmlPath": "@isBitMask",
              "default": false,
              "nameKey": "DrvModbusCategoriesReadCommandsFieldsRegistersFieldsIsBitMaskName"
            }
          ],
          "nameKey": "DrvModbusCategoriesReadCommandsFieldsRegistersName",
          "itemNameKey": "DrvModbusCategoriesReadCommandsFieldsRegistersItemName"
        }
      ],
      "nameKey": "DrvModbusCategoriesReadCommandsName",
      "itemNameKey": "DrvModbusCategoriesReadCommandsItemName"
    },
    {
      "id": "commands",
      "name": "Write commands",
      "isList": true,
      "itemName": "Command",
      "xmlPath": "/DeviceTemplate/Cmds/Cmd",
      "fields": [
        {
          "id": "commandCode",
          "name": "Command code",
          "type": "string",
          "order": 10,
          "xmlPath": "@cmdCode",
          "default": "CMD_1",
          "nameKey": "DrvModbusCategoriesCommandsFieldsCommandCodeName"
        },
        {
          "id": "commandNumber",
          "name": "Command number",
          "type": "integer",
          "min": 0,
          "max": 65535,
          "order": 20,
          "xmlPath": "@cmdNum",
          "default": 1,
          "nameKey": "DrvModbusCategoriesCommandsFieldsCommandNumberName"
        },
        {
          "id": "name",
          "name": "Name",
          "type": "string",
          "required": true,
          "order": 30,
          "xmlPath": "@name",
          "default": "CMD_1",
          "nameKey": "DrvModbusCategoriesCommandsFieldsNameName"
        },
        {
          "id": "dataBlock",
          "name": "Data block",
          "type": "select",
          "required": true,
          "order": 40,
          "xmlPath": "@dataBlock",
          "default": "Coils",
          "options": [
            {
              "value": "Coils",
              "label": "Coils",
              "labelKey": "DrvModbusCategoriesCommandsFieldsDataBlockOptionsCoilsLabel"
            },
            {
              "value": "HoldingRegisters",
              "label": "Holding Registers",
              "labelKey": "DrvModbusCategoriesCommandsFieldsDataBlockOptionsHoldingRegistersLabel"
            },
            {
              "value": "Custom",
              "label": "Custom",
              "labelKey": "DrvModbusCategoriesCommandsFieldsDataBlockOptionsCustomLabel"
            }
          ],
          "nameKey": "DrvModbusCategoriesCommandsFieldsDataBlockName"
        },
        {
          "id": "address",
          "name": "Address",
          "type": "integer",
          "min": 0,
          "max": 65535,
          "order": 50,
          "xmlPath": "@address",
          "default": 0,
          "dependsOn": {
            "fieldId": "dataBlock",
            "operator": "notEquals",
            "value": "Custom"
          },
          "nameKey": "DrvModbusCategoriesCommandsFieldsAddressName"
        },
        {
          "id": "multiple",
          "name": "Multiple elements",
          "type": "boolean",
          "order": 60,
          "xmlPath": "@multiple",
          "default": false,
          "dependsOn": {
            "fieldId": "dataBlock",
            "operator": "notEquals",
            "value": "Custom"
          },
          "nameKey": "DrvModbusCategoriesCommandsFieldsMultipleName"
        },
        {
          "id": "elementType",
          "name": "Element type",
          "type": "select",
          "order": 70,
          "xmlPath": "@elemType",
          "default": "bool",
          "omitIfDefault": true,
          "dependsOn": {
            "fieldId": "multiple",
            "operator": "equals",
            "value": "true"
          },
          "options": [
            {
              "value": "bool",
              "label": "Boolean",
              "labelKey": "DrvModbusCategoriesCommandsFieldsElementTypeOptionsBoolLabel"
            },
            {
              "value": "short",
              "label": "Int16",
              "labelKey": "DrvModbusCategoriesCommandsFieldsElementTypeOptionsShortLabel"
            },
            {
              "value": "ushort",
              "label": "UInt16",
              "labelKey": "DrvModbusCategoriesCommandsFieldsElementTypeOptionsUshortLabel"
            },
            {
              "value": "int",
              "label": "Int32",
              "labelKey": "DrvModbusCategoriesCommandsFieldsElementTypeOptionsIntLabel"
            },
            {
              "value": "uint",
              "label": "UInt32",
              "labelKey": "DrvModbusCategoriesCommandsFieldsElementTypeOptionsUintLabel"
            },
            {
              "value": "float",
              "label": "Float32",
              "labelKey": "DrvModbusCategoriesCommandsFieldsElementTypeOptionsFloatLabel"
            },
            {
              "value": "double",
              "label": "Double",
              "labelKey": "DrvModbusCategoriesCommandsFieldsElementTypeOptionsDoubleLabel"
            }
          ],
          "nameKey": "DrvModbusCategoriesCommandsFieldsElementTypeName"
        },
        {
          "id": "elementCount",
          "name": "Element count",
          "type": "integer",
          "min": 1,
          "max": 125,
          "order": 80,
          "xmlPath": "@elemCnt",

          "xmlPath": "@name",
          "default": "Read command",
          "nameKey": "DrvModbusCategoriesReadCommandsFieldsNameName"
        },
        {
          "id": "dataBlock",
          "name": "Data block",
          "type": "select",
          "required": true,
          "order": 30,
          "xmlPath": "@dataBlock",
          "default": "HoldingRegisters",
          "options": [
            {
              "value": "DiscreteInputs",

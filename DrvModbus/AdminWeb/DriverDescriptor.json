{
  "driverCode": "DrvModbus",
  "driverName": "Modbus",
  "version": "1.0.1",
  "description": "TreeView version of the Modbus device template descriptor.",
  "configFile": "DriverConfigs/DrvModbus.xml",
  "omitRootCodeAttribute": true,
  "assets": {
    "styles": [
      "/drivers/DrvModbus/driver.css"
    ]
  },
  "actionProvider": {
    "assemblyFile": "$(AppDir)/Drivers/DrvModbus/runtime/DrvModbus.View.dll",
    "entryPoint": "Scada.Comm.Drivers.DrvModbus.View.AdminActionProvider"
  },
  "actions": [
    {
      "actionId": "GetTags",
      "name": "Get tags",
      "description": "Builds the tag list from read commands and their registers.",
      "placement": "categoryToolbar",
      "categoryId": "readCommands",
      "input": {
        "readCommands": "listValues.readCommands",
        "readCommandRegisters": "nestedGridValues.readCommands"
      },
      "result": {
        "type": "table",
        "target": "values.readCommands.tags"
      },
      "nameKey": "DrvModbusActionsGetTagsName",
      "descriptionKey": "DrvModbusActionsGetTagsDescription"
    },
    {
      "actionId": "GetSampleRegisters",
      "name": "Add sample registers",
      "description": "Adds sample rows to the selected read command's nested register table.",
      "placement": "categoryToolbar",
      "categoryId": "readCommands",
      "result": {
        "type": "list",
        "target": "nestedGridValues.readCommands.selected.registers",
        "applyMode": "append"
      },
      "nameKey": "DrvModbusActionsGetSampleRegistersName",
      "descriptionKey": "DrvModbusActionsGetSampleRegistersDescription"
    },
    {
      "actionId": "PreviewSelectedReadCommand",
      "name": "Preview selected command",
      "description": "Shows the read command and registers selected in the tree.",
      "placement": "categoryToolbar",
      "categoryId": "readCommands",
      "input": {
        "readCommand": "listValues.readCommands.selected",
        "readCommandRegisters": "nestedGridValues.readCommands.selected"
      },
      "result": {
        "type": "table",
        "target": "values.readCommands.selectedPreview"
      },
      "nameKey": "DrvModbusActionsPreviewSelectedReadCommandName",
      "descriptionKey": "DrvModbusActionsPreviewSelectedReadCommandDescription"
    },
    {
      "actionId": "GetCommands",
      "name": "Get commands",
      "description": "Builds the command list from the current command table.",
      "placement": "categoryToolbar",
      "categoryId": "commands",
      "input": {
        "commands": "listValues.commands"
      },
      "result": {
        "type": "table",
        "target": "values.commands.commands"
      },
      "nameKey": "DrvModbusActionsGetCommandsName",
      "descriptionKey": "DrvModbusActionsGetCommandsDescription"
    }
  ],
  "categories": [
    {
      "id": "options",
      "name": "Options",
      "isSingleton": true,
      "columns": 2,
      "xmlPath": "/DeviceTemplate/Options",
      "fields": [
        {
          "id": "zeroAddr",
          "name": "Zero-based addresses",
          "type": "boolean",
          "order": 10,
          "xmlPath": "ZeroAddr",
          "default": false,
          "nameKey": "DrvModbusCategoriesOptionsFieldsZeroAddrName"
        },
        {
          "id": "decAddr",
          "name": "Decimal addresses",
          "type": "boolean",
          "order": 20,
          "xmlPath": "DecAddr",
          "default": true,
          "nameKey": "DrvModbusCategoriesOptionsFieldsDecAddrName"
        },
        {
          "id": "defByteOrder2",
          "name": "Byte order 2",
          "type": "string",
          "order": 30,
          "xmlPath": "DefByteOrder2",
          "default": "",
          "nameKey": "DrvModbusCategoriesOptionsFieldsDefByteOrder2Name"
        },
        {
          "id": "defByteOrder4",
          "name": "Byte order 4",
          "type": "string",
          "order": 40,
          "xmlPath": "DefByteOrder4",
          "default": "",
          "nameKey": "DrvModbusCategoriesOptionsFieldsDefByteOrder4Name"
        },
        {
          "id": "defByteOrder8",
          "name": "Byte order 8",
          "type": "string",
          "order": 50,
          "xmlPath": "DefByteOrder8",
          "default": "",
          "nameKey": "DrvModbusCategoriesOptionsFieldsDefByteOrder8Name"
        }
      ],
      "nameKey": "DrvModbusCategoriesOptionsName"
    },
    {
      "id": "readCommands",
      "name": "Read commands",
      "isList": true,
      "viewMode": "tree",
      "itemName": "Read command",
      "xmlPath": "/DeviceTemplate/ElemGroups/ElemGroup",

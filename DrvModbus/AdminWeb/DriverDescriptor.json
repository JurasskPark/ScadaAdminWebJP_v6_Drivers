            },
            {
              "value": "Custom",
              "label": "Custom",
              "labelKey": "DrvModbusCategoriesReadCommandsFieldsDataBlockOptionsCustomLabel"
            }
          ],
          "nameKey": "DrvModbusCategoriesReadCommandsFieldsDataBlockName"
        },
        {
          "id": "address",
          "name": "Start address",

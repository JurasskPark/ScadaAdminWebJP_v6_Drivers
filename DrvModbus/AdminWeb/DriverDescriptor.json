          "omitIfDefault": true,
          "dependsOn": {
            "fieldId": "multiple",
            "operator": "equals",
            "value": "true"
          },
          "nameKey": "DrvModbusCategoriesCommandsFieldsElementCountName"
        },
        {
          "id": "byteOrder",
          "name": "Byte order",
          "type": "string",
          "order": 90,
          "xmlPath": "@byteOrder",
          "default": "",
          "omitIfEmpty": true,
          "dependsOn": {
            "fieldId": "multiple",
            "operator": "equals",
            "value": "true"
          },
          "nameKey": "DrvModbusCategoriesCommandsFieldsByteOrderName"
        },
        {
          "id": "functionCode",
          "name": "Function code",
          "type": "integer",
          "min": 0,
          "max": 255,
          "order": 100,
          "xmlPath": "@funcCode",
          "default": 0,
          "dependsOn": {
            "fieldId": "dataBlock",

{
  "driverCode": "DrvSimulator",
  "driverName": "Device Simulator",
  "version": "1.0.0",
  "description": "Web editor descriptor for simulator driver static channel prototypes.",
  "configSource": "deviceCustomOptions",
  "actionProvider": {
    "assemblyFile": "$(AppDir)/Drivers/DrvSimulator/runtime/DrvSimulator.View.dll",
    "entryPoint": "Scada.Comm.Drivers.DrvSimulator.View.AdminActionProvider"
  },
  "actions": [
    {
      "actionId": "GetTags",
      "name": "Get tags",
      "description": "Shows the device simulator channels.",

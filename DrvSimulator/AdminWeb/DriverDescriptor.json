  "categories": [
    {
      "id": "channels",
      "name": "Channels",
      "isSingleton": true,
      "columns": 2,
      "fields": [],
      "nameKey": "DrvSimulatorCategoriesChannelsName"
    }
  ],
  "driverNameKey": "DrvSimulatorDriverName",
  "descriptionKey": "DrvSimulatorDescription"
}
